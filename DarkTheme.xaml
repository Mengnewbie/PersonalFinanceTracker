<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══ Dark Theme Color Palette ═══ -->
    <SolidColorBrush x:Key="BgBrush" Color="#0F1117"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#181A24"/>
    <SolidColorBrush x:Key="Surface2Brush" Color="#1E2030"/>
    <SolidColorBrush x:Key="Surface3Brush" Color="#252838"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#2A2D3E"/>
    <SolidColorBrush x:Key="TextBrush" Color="#E4E6F0"/>
    <SolidColorBrush x:Key="Text2Brush" Color="#8B8FA3"/>
    <SolidColorBrush x:Key="Text3Brush" Color="#5C5F73"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#7C6AEF"/>
    <SolidColorBrush x:Key="GreenBrush" Color="#2DD4A8"/>
    <SolidColorBrush x:Key="GreenDimBrush" Color="#162E28"/>
    <SolidColorBrush x:Key="RedBrush" Color="#F06C75"/>
    <SolidColorBrush x:Key="RedDimBrush" Color="#2E1A1E"/>
    <SolidColorBrush x:Key="BlueBrush" Color="#7C6AEF"/>
    <SolidColorBrush x:Key="BlueDimBrush" Color="#1C1A2E"/>
    <SolidColorBrush x:Key="OrangeBrush" Color="#FBBF24"/>
    <SolidColorBrush x:Key="OrangeDimBrush" Color="#2E2818"/>
    <SolidColorBrush x:Key="PurpleBrush" Color="#A78BFA"/>
    <SolidColorBrush x:Key="PurpleDimBrush" Color="#221A2E"/>

    <!-- ═══ Dark Button Style ═══ -->
    <Style x:Key="DarkBtn" TargetType="Button">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="16,10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ Dialog Button Style ═══ -->
    <Style x:Key="DialogBtn" TargetType="Button">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            CornerRadius="10" Padding="0,10">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ Field Label Style ═══ -->
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Text3Brush}"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <!-- ═══ Sidebar Button Style ═══ -->
    <Style x:Key="SidebarButton" TargetType="Button">
        <Setter Property="Height" Value="46"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Text2Brush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="20,0,0,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}"
                            CornerRadius="10" Margin="8,2"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource Surface2Brush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
