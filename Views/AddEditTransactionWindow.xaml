<Window x:Class="PersonalFinanceTracker.Views.AddEditTransactionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Transaction" 
        Height="660" Width="500"
        MinHeight="660" MinWidth="460"
        WindowStartupLocation="CenterOwner" 
        Background="#0F1117" 
        ResizeMode="CanResizeWithGrip"
        Loaded="Window_Loaded">
    <Border Background="{StaticResource SurfaceBrush}" Padding="32">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <TextBlock Grid.Row="0" Text="Add Transaction" 
                       FontSize="22" FontWeight="Bold" 
                       Foreground="{StaticResource TextBrush}" 
                       Margin="0,0,0,28"/>

            <!-- Date -->
            <StackPanel Grid.Row="1" Margin="0,0,0,16">
                <TextBlock Text="DATE" Style="{StaticResource FieldLabel}"/>
                <DatePicker x:Name="DatePicker" FontSize="14" Padding="8" Height="40"/>
            </StackPanel>

            <!-- Description -->
            <StackPanel Grid.Row="2" Margin="0,0,0,16">
                <TextBlock Text="DESCRIPTION" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="DescriptionTextBox" FontSize="14" Padding="10,8" Height="40"
                         Background="{StaticResource Surface2Brush}" 
                         Foreground="{StaticResource TextBrush}"
                         BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" 
                         CaretBrush="{StaticResource TextBrush}" 
                         TextChanged="Input_Changed"/>
            </StackPanel>

            <!-- Type -->
            <StackPanel Grid.Row="3" Margin="0,0,0,16">
                <TextBlock Text="TYPE" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="TypeComboBox" FontSize="14" Padding="8" Height="40"
                          SelectionChanged="TypeComboBox_SelectionChanged">
                    <ComboBoxItem Content="Income" IsSelected="True"/>
                    <ComboBoxItem Content="Expense"/>
                </ComboBox>
            </StackPanel>

            <!-- Category -->
            <StackPanel Grid.Row="4" Margin="0,0,0,16">
                <TextBlock Text="CATEGORY" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="CategoryComboBox" FontSize="14" Padding="8" Height="40"
                          DisplayMemberPath="Name"/>
            </StackPanel>

            <!-- Amount + Currency -->
            <Grid Grid.Row="5" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="AMOUNT" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="AmountTextBox" FontSize="14" Padding="10,8" Height="40"
                             Background="{StaticResource Surface2Brush}" 
                             Foreground="{StaticResource TextBrush}"
                             BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" 
                             CaretBrush="{StaticResource TextBrush}"
                             PreviewTextInput="AmountTextBox_PreviewTextInput" 
                             TextChanged="Input_Changed"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="CURRENCY" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="CurrencyComboBox" FontSize="14" Padding="8" Height="40"
                              DisplayMemberPath="Code"
                              SelectionChanged="CurrencyComboBox_SelectionChanged"/>
                </StackPanel>
            </Grid>

            <!-- Conversion Info -->
            <Border Grid.Row="6" Background="{StaticResource Surface2Brush}" 
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" 
                    CornerRadius="10" Padding="12" Margin="0,0,0,8">
                <TextBlock x:Name="ConversionInfoText" FontSize="12" 
                           Foreground="{StaticResource Text2Brush}" TextWrapping="Wrap"
                           Text="Enter amount in selected currency"/>
            </Border>

            <!-- Spacer -->
            <Border Grid.Row="7"/>

            <!-- Buttons -->
            <Grid Grid.Row="8" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Cancel" Height="42"
                        Click="CancelButton_Click" 
                        Background="{StaticResource Surface2Brush}" 
                        Foreground="{StaticResource Text2Brush}" 
                        Style="{StaticResource DialogBtn}" Margin="0,0,6,0"/>
                <Button Grid.Column="1" Content="Save" Height="42"
                        Click="SaveButton_Click" 
                        Background="{StaticResource GreenBrush}" 
                        Style="{StaticResource DialogBtn}" Margin="6,0,0,0"/>
            </Grid>
        </Grid>
    </Border>
</Window>
