<Window x:Class="PersonalFinanceTracker.Views.AddEditBudgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Budget" 
        Height="520" Width="500"
        MinHeight="500" MinWidth="460"
        WindowStartupLocation="CenterOwner" 
        Background="#0F1117" 
        ResizeMode="CanResizeWithGrip">
    <Border Background="{StaticResource SurfaceBrush}" Padding="32">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Add Budget" FontSize="22" FontWeight="Bold" 
                       Foreground="{StaticResource TextBrush}" Margin="0,0,0,28"/>

            <StackPanel Grid.Row="1" Margin="0,0,0,16">
                <TextBlock Text="CATEGORY" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="CategoryComboBox" FontSize="14" Padding="8" Height="40" DisplayMemberPath="Name"/>
            </StackPanel>

            <Grid Grid.Row="2" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="BUDGET AMOUNT" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="BudgetAmountTextBox" FontSize="14" Padding="10,8" Height="40"
                             Background="{StaticResource Surface2Brush}" Foreground="{StaticResource TextBrush}"
                             BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" 
                             CaretBrush="{StaticResource TextBrush}"
                             PreviewTextInput="BudgetAmountTextBox_PreviewTextInput"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="CURRENCY" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="CurrencyComboBox" FontSize="14" Padding="8" Height="40" DisplayMemberPath="Code"/>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="3" Margin="0,0,0,16">
                <TextBlock Text="PERIOD" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="PeriodComboBox" FontSize="14" Padding="8" Height="40">
                    <ComboBoxItem Content="Monthly" IsSelected="True"/>
                    <ComboBoxItem Content="Weekly"/>
                    <ComboBoxItem Content="Yearly"/>
                </ComboBox>
            </StackPanel>

            <Border Grid.Row="4" Background="{StaticResource Surface2Brush}" 
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" 
                    CornerRadius="10" Padding="12" Margin="0,0,0,8">
                <TextBlock FontSize="12" Foreground="{StaticResource Text2Brush}" TextWrapping="Wrap">
                    <Run Text="ℹ Tip:" FontWeight="Bold"/>
                    <Run Text=" Budget will track spending in the selected currency. Transactions are auto-converted."/>
                </TextBlock>
            </Border>

            <Border Grid.Row="5"/>

            <Grid Grid.Row="6" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Cancel" Height="42" Click="CancelButton_Click" 
                        Background="{StaticResource Surface2Brush}" Foreground="{StaticResource Text2Brush}" 
                        Style="{StaticResource DialogBtn}" Margin="0,0,6,0"/>
                <Button Grid.Column="1" Content="Save" Height="42" Click="SaveButton_Click" 
                        Background="{StaticResource GreenBrush}" 
                        Style="{StaticResource DialogBtn}" Margin="6,0,0,0"/>
            </Grid>
        </Grid>
    </Border>
</Window>
