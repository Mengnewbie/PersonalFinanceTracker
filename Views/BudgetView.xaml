<UserControl x:Class="PersonalFinanceTracker.Views.BudgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewmodels="clr-namespace:PersonalFinanceTracker.ViewModels"
             Background="Transparent">
    <UserControl.DataContext>
        <viewmodels:BudgetViewModel/>
    </UserControl.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Budget Tracking" Foreground="{StaticResource TextBrush}" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
            <Button Content="＋ Add Budget" Command="{Binding AddBudgetCommand}" Background="#2DD4A8" Style="{StaticResource DarkBtn}" Margin="0,0,8,0"/>
            <Button Content="✎ Edit" Command="{Binding EditBudgetCommand}" Background="{StaticResource AccentBrush}" Style="{StaticResource DarkBtn}" Margin="0,0,8,0"/>
            <Button Content="✕ Delete" Command="{Binding DeleteBudgetCommand}" Background="#F06C75" Style="{StaticResource DarkBtn}"/>
        </StackPanel>
        <ListBox Grid.Row="2" ItemsSource="{Binding BudgetItems}" SelectedItem="{Binding SelectedBudgetItem}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border Background="{TemplateBinding Background}">
                                    <ContentPresenter/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="Transparent"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border CornerRadius="14" Padding="22" Margin="0,0,0,12">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                        <Setter Property="Background" Value="#1C1A2E"/>
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1E2030"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Icon}" FontSize="22" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding Category}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border HorizontalAlignment="Right" CornerRadius="12" Padding="12,5">
                                    <Border.Background>
                                        <SolidColorBrush Color="{Binding StatusColor}"/>
                                    </Border.Background>
                                    <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                            </Grid>
                            <ProgressBar Grid.Row="1" Height="8" Value="{Binding ProgressPercentage}" Maximum="100" Background="#252838" Foreground="{Binding StatusColor}" BorderThickness="0" Margin="0,0,0,12"/>
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="BUDGET" FontSize="10" Foreground="{StaticResource Text3Brush}" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding BudgetAmountFormatted}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="SPENT" FontSize="10" Foreground="{StaticResource Text3Brush}" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding SpentFormatted}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource RedBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="REMAINING" FontSize="10" Foreground="{StaticResource Text3Brush}" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding RemainingFormatted}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource GreenBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
