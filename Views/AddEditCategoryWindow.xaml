<Window x:Class="PersonalFinanceTracker.Views.AddEditCategoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Category" 
        Height="520" Width="500"
        MinHeight="500" MinWidth="460"
        WindowStartupLocation="CenterOwner" 
        Background="#0F1117" 
        ResizeMode="CanResizeWithGrip">
    <Border Background="{StaticResource SurfaceBrush}" Padding="32">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Add Category" FontSize="22" FontWeight="Bold" 
                       Foreground="{StaticResource TextBrush}" Margin="0,0,0,28"/>

            <StackPanel Grid.Row="1" Margin="0,0,0,16">
                <TextBlock Text="NAME" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="NameTextBox" FontSize="14" Padding="10,8" Height="40"
                         Background="{StaticResource Surface2Brush}" Foreground="{StaticResource TextBrush}"
                         BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" 
                         CaretBrush="{StaticResource TextBrush}"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="0,0,0,16">
                <TextBlock Text="TYPE" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="TypeComboBox" FontSize="14" Padding="8" Height="40">
                    <ComboBoxItem Content="Income" IsSelected="True"/>
                    <ComboBoxItem Content="Expense"/>
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Row="3" Margin="0,0,0,16">
                <TextBlock Text="ICON (EMOJI)" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="IconTextBox" FontSize="14" Padding="10,8" Height="40" MaxLength="2" Text="📁"
                         Background="{StaticResource Surface2Brush}" Foreground="{StaticResource TextBrush}"
                         BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" 
                         CaretBrush="{StaticResource TextBrush}"/>
            </StackPanel>

            <StackPanel Grid.Row="4" Margin="0,0,0,16">
                <TextBlock Text="COLOR (HEX)" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="ColorTextBox" FontSize="14" Padding="10,8" Height="40" Text="#3498DB"
                         Background="{StaticResource Surface2Brush}" Foreground="{StaticResource TextBrush}"
                         BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" 
                         CaretBrush="{StaticResource TextBrush}"/>
            </StackPanel>

            <Border Grid.Row="5"/>

            <Grid Grid.Row="6" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Cancel" Height="42" Click="CancelButton_Click" 
                        Background="{StaticResource Surface2Brush}" Foreground="{StaticResource Text2Brush}" 
                        Style="{StaticResource DialogBtn}" Margin="0,0,6,0"/>
                <Button Grid.Column="1" Content="Save" Height="42" Click="SaveButton_Click" 
                        Background="{StaticResource GreenBrush}" 
                        Style="{StaticResource DialogBtn}" Margin="6,0,0,0"/>
            </Grid>
        </Grid>
    </Border>
</Window>
