<Window x:Class="PersonalFinanceTracker.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PersonalFinanceTracker.Views"
        xmlns:viewmodels="clr-namespace:PersonalFinanceTracker.ViewModels"
        Title="{Binding Title}" Height="750" Width="1280"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen" Background="#0F1117">
    <Window.DataContext>
        <viewmodels:MainViewModel />
    </Window.DataContext>
    <Window.InputBindings>
        <KeyBinding Key="D" Modifiers="Ctrl" Command="{Binding NavigateToDashboardCommand}"/>
        <KeyBinding Key="T" Modifiers="Ctrl" Command="{Binding NavigateToTransactionsCommand}"/>
        <KeyBinding Key="C" Modifiers="Ctrl" Command="{Binding NavigateToCategoriesCommand}"/>
        <KeyBinding Key="R" Modifiers="Ctrl" Command="{Binding NavigateToReportsCommand}"/>
        <KeyBinding Key="B" Modifiers="Ctrl" Command="{Binding NavigateToBudgetCommand}"/>
    </Window.InputBindings>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <!-- SIDEBAR -->
        <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="20,24,20,28">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="36" Height="36" CornerRadius="10" Margin="0,0,12,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#7C6AEF" Offset="0"/>
                                    <GradientStop Color="#A78BFA" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="₣" Foreground="White" FontSize="18" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="FinTrack" Foreground="{StaticResource TextBrush}" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="Personal Finance" Foreground="{StaticResource Text2Brush}" FontSize="10" Margin="0,-1,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Row="1">
                    <TextBlock Text="MENU" Foreground="{StaticResource Text2Brush}" FontSize="10"
                               FontWeight="SemiBold" Margin="28,0,0,8" Opacity="0.6"/>
                    <Button Content="  📊  Dashboard" Command="{Binding NavigateToDashboardCommand}" Style="{StaticResource SidebarButton}"/>
                    <Button Content="  💳  Transactions" Command="{Binding NavigateToTransactionsCommand}" Style="{StaticResource SidebarButton}"/>
                    <Button Content="  📁  Categories" Command="{Binding NavigateToCategoriesCommand}" Style="{StaticResource SidebarButton}"/>
                    <Button Content="  📈  Reports" Command="{Binding NavigateToReportsCommand}" Style="{StaticResource SidebarButton}"/>
                    <Button Content="  💰  Budget" Command="{Binding NavigateToBudgetCommand}" Style="{StaticResource SidebarButton}"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Margin="12,0,12,16">
                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="8,0,8,12"/>
                    <Button Content="⚙️  Settings" Click="SettingsButton_Click" Style="{StaticResource SidebarButton}"/>
                </StackPanel>
            </Grid>
        </Border>
        <!-- CONTENT -->
        <Border Grid.Column="1" Background="{StaticResource BgBrush}" Padding="32,24">
            <ContentControl Content="{Binding CurrentViewModel}">
                <ContentControl.Resources>
                    <DataTemplate DataType="{x:Type viewmodels:DashboardViewModel}">
                        <local:DashboardView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type viewmodels:TransactionsViewModel}">
                        <local:TransactionsView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type viewmodels:CategoriesViewModel}">
                        <local:CategoriesView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type viewmodels:ReportsViewModel}">
                        <local:ReportsView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type viewmodels:BudgetViewModel}">
                        <local:BudgetView/>
                    </DataTemplate>
                </ContentControl.Resources>
            </ContentControl>
        </Border>
    </Grid>
</Window>
