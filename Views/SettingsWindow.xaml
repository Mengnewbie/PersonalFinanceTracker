<Window x:Class="PersonalFinanceTracker.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" 
        Height="520" Width="520"
        MinHeight="480" MinWidth="460"
        WindowStartupLocation="CenterOwner" 
        Background="#0F1117" 
        ResizeMode="CanResizeWithGrip">
    <Border Background="{StaticResource SurfaceBrush}" Padding="32">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Settings" FontSize="22" FontWeight="Bold" 
                       Foreground="{StaticResource TextBrush}" Margin="0,0,0,28"/>

            <Border Grid.Row="1" Background="{StaticResource Surface2Brush}" 
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" 
                    CornerRadius="14" Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="💱 Currency" FontSize="16" FontWeight="SemiBold" 
                               Foreground="{StaticResource TextBrush}" Margin="0,0,0,10"/>
                    <TextBlock Text="Select your preferred display currency:" FontSize="12" 
                               Foreground="{StaticResource Text3Brush}" Margin="0,0,0,10"/>
                    <ComboBox x:Name="CurrencyComboBox" DisplayMemberPath="DisplayName" 
                              Height="42" Padding="12,8" FontSize="14" 
                              SelectionChanged="CurrencyComboBox_SelectionChanged"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Background="#1C1A2E" BorderBrush="#2A2450" BorderThickness="1" 
                    CornerRadius="10" Padding="14" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="ℹ️" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Top"/>
                    <TextBlock FontSize="12" Foreground="{StaticResource Text2Brush}" TextWrapping="Wrap">
                        <Run Text="Note:" FontWeight="Bold"/>
                        <Run Text=" This changes the display currency only. Transaction amounts are stored in their original currency."/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Grid.Row="3" Background="{StaticResource Surface2Brush}" 
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" 
                    CornerRadius="14" Padding="20">
                <StackPanel>
                    <TextBlock Text="PREVIEW" FontSize="11" FontWeight="SemiBold" 
                               Foreground="{StaticResource Text3Brush}" Margin="0,0,0,16"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="Example:" FontSize="13" Foreground="{StaticResource Text3Brush}" Width="120"/>
                        <TextBlock x:Name="PreviewText" Text="$1,234.56" FontSize="18" FontWeight="Bold" 
                                   Foreground="{StaticResource TextBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="From $100:" FontSize="13" Foreground="{StaticResource Text3Brush}" Width="120"/>
                        <TextBlock x:Name="PreviewRiel" Text="$100.00" FontSize="18" FontWeight="Bold" 
                                   Foreground="{StaticResource TextBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid Grid.Row="4" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Cancel" Height="42" Click="CancelButton_Click" 
                        Background="{StaticResource Surface2Brush}" Foreground="{StaticResource Text2Brush}" 
                        Style="{StaticResource DialogBtn}" Margin="0,0,6,0"/>
                <Button Grid.Column="1" Content="Save &amp; Apply" Height="42" Click="SaveButton_Click" 
                        Background="{StaticResource GreenBrush}" 
                        Style="{StaticResource DialogBtn}" Margin="6,0,0,0"/>
            </Grid>
        </Grid>
    </Border>
</Window>
