<UserControl x:Class="PersonalFinanceTracker.Views.TransactionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewmodels="clr-namespace:PersonalFinanceTracker.ViewModels"
             Background="Transparent">
    <UserControl.DataContext>
        <viewmodels:TransactionsViewModel/>
    </UserControl.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Transactions" Foreground="{StaticResource TextBrush}" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
            <Button Content="＋ Add" Command="{Binding AddCommand}" Background="#2DD4A8" Style="{StaticResource DarkBtn}" Margin="0,0,8,0"/>
            <Button Content="✎ Edit" Command="{Binding EditCommand}" Background="{StaticResource AccentBrush}" Style="{StaticResource DarkBtn}" Margin="0,0,8,0"/>
            <Button Content="✕ Delete" Command="{Binding DeleteCommand}" Background="#F06C75" Style="{StaticResource DarkBtn}" Margin="0,0,20,0"/>
            <Button Content="↺ Clear Filters" Command="{Binding ClearFiltersCommand}" Background="{StaticResource Surface3Brush}" Style="{StaticResource DarkBtn}"/>
        </StackPanel>
        <!-- Filters -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="SEARCH" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="12,8" FontSize="13" Background="{StaticResource Surface2Brush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CaretBrush="{StaticResource TextBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="5,0,5,0">
                        <TextBlock Text="TYPE" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding TypeFilters}" SelectedItem="{Binding SelectedTypeFilter}" Height="36" Padding="12,5" FontSize="13"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="5,0,5,0">
                        <TextBlock Text="CATEGORY" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding CategoryFilters}" SelectedItem="{Binding SelectedCategoryFilter}" Height="36" Padding="12,5" FontSize="13"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="10,0,0,0">
                        <TextBlock Text="SORT BY" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSortOption}" Height="36" Padding="12,5" FontSize="13"/>
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="FROM" Style="{StaticResource FieldLabel}"/>
                        <DatePicker SelectedDate="{Binding StartDate}" Height="36" FontSize="13"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="5,0,5,0">
                        <TextBlock Text="TO" Style="{StaticResource FieldLabel}"/>
                        <DatePicker SelectedDate="{Binding EndDate}" Height="36" FontSize="13"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Bottom" FontSize="12" Foreground="{StaticResource Text2Brush}">
                        <Run Text="Showing "/><Run Text="{Binding DisplayedCount, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/><Run Text=" of "/><Run Text="{Binding TotalCount, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/><Run Text=" transactions"/>
                    </TextBlock>
                </Grid>
            </Grid>
        </Border>
        <!-- DataGrid -->
        <Grid Grid.Row="3">
            <DataGrid ItemsSource="{Binding FilteredTransactions}" SelectedItem="{Binding SelectedTransaction}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" SelectionMode="Single" GridLinesVisibility="None" HeadersVisibility="Column" Background="#181A24" RowBackground="#181A24" AlternatingRowBackground="#1C1E2A" BorderThickness="1" BorderBrush="#2A2D3E" Foreground="#E4E6F0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat='MMM dd, yyyy'}" Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="#E4E6F0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" MinWidth="150">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="#E4E6F0"/>
                                <Setter Property="Padding" Value="5,0,0,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="150">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#8B8FA3"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Type}" Value="Income">
                                        <Setter Property="Foreground" Value="#2DD4A8"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Type}" Value="Expense">
                                        <Setter Property="Foreground" Value="#F06C75"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="Amount" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Margin="0,0,5,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="FontSize" Value="14"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Type}" Value="Income">
                                                        <Setter Property="Foreground" Value="#2DD4A8"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Type}" Value="Expense">
                                                        <Setter Property="Foreground" Value="#F06C75"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style><Run Text="{Binding Amount, StringFormat=N2}"/></TextBlock>
                                    <TextBlock Text="{Binding Currency}" FontSize="11" Foreground="#5C5F73" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#1E2030"/>
                        <Setter Property="Foreground" Value="#8B8FA3"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="Padding" Value="12,10"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#2A2D3E"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Height" Value="46"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#252838"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#1C1A2E"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="10,0"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="Transparent"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.InputBindings>
                    <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding RowDoubleClickCommand}"/>
                </DataGrid.InputBindings>
            </DataGrid>
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="14" Padding="40" VerticalAlignment="Center" HorizontalAlignment="Center" Panel.ZIndex="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DisplayedCount}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="📝" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <TextBlock Text="No Transactions Found" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Text2Brush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Try adjusting your filters or add a new transaction" FontSize="13" Foreground="{StaticResource Text3Brush}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
        <!-- Footer -->
        <Border Grid.Row="4" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20,12" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="{StaticResource Text3Brush}" FontSize="12" Text="💡 Double-click any row to edit"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,28,0">
                    <TextBlock Text="Income: " Foreground="{StaticResource Text3Brush}" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding DisplayedIncomeFormatted}" Foreground="{StaticResource GreenBrush}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,28,0">
                    <TextBlock Text="Expenses: " Foreground="{StaticResource Text3Brush}" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding DisplayedExpensesFormatted}" Foreground="{StaticResource RedBrush}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <TextBlock Text="Balance: " Foreground="{StaticResource Text3Brush}" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding DisplayedBalanceFormatted}" Foreground="{StaticResource AccentBrush}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
